  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7c2ab02381844c41be62ea5d0231284, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleDialogueTrigger
  triggerOnlyOnce: 1
  dialogueLines:
  - speaker: 2
    message: Has visto demasiado, esta realidad es mi puesta en escena, y tu no tienes
      derecho de ir y venir cuando quieras
  - speaker: 1
    message: Que es eso??
  - speaker: 3
    message: El ser que esta cambiando tu realidad, intentara cazarte para que dejes
      de cambiar entre nuestro mundos, pero solo puede moverse en su plano.....
  - speaker: 3
    message: Se rapido y no dejes que te atrape
